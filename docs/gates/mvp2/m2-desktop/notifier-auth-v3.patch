@@ -59,6 +60,47 @@ class Settings:
     credential_target: str
     session_index: Path
     state_path: Path
+    bridge_state_path: Path | None = None
+
+
+_BRIDGE_CLIENT_MESSAGE = re.compile(r"nobus:[0-9a-f-]{36}\Z")
+
+
+def registered_bridge_turn(
+    state_path: Path, *, request_id: str, thread_id: str, turn_id: str
+) -> bool:
+    """Read-only exact binding; a copied marker never authenticates a turn."""
+    try:
+        identifier = str(UUID(request_id))
+        thread = str(UUID(thread_id))
+        if not isinstance(turn_id, str) or not turn_id or len(turn_id) > 256:
+            return False
+        path = Path(state_path)
+        if not path.is_absolute() or not path.is_file() or path.is_symlink():
+            return False
+        with contextlib.closing(
+            sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=1)
+        ) as connection:
+            connection.execute("PRAGMA query_only=ON")
+            row = connection.execute(
+                """SELECT desktop_thread_id,desktop_turn_id,client_message_id,
+                          status,chat_id,topic_id
+                   FROM desktop_bridge_requests WHERE request_id=?""",
+                (identifier,),
+            ).fetchone()
+        return bool(
+            row is not None
+            and row[0] == thread
+            and row[1] == turn_id
+            and isinstance(row[2], str)
+            and _BRIDGE_CLIENT_MESSAGE.fullmatch(row[2]) is not None
+            and row[2] == f"nobus:{identifier}"
+            and row[3] not in {"cancelled", "failed"}
+            and type(row[4]) is int and row[4] < 0
+            and (row[5] is None or type(row[5]) is int and row[5] > 0)
+        )
+    except (OSError, ValueError, sqlite3.Error):
+        return False
 
 
